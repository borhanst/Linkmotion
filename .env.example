# AI News Agent - environment configuration.
# Copy to .env and fill in keys you have. All keys are optional - the
# zero-key path (edge-tts + Playwright + Remotion) works out of the box.

# LLM provider for research/script drafting
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Budget governance
BUDGET_MODE=warn
BUDGET_TOTAL_USD=10.00
BUDGET_RESERVE_PCT=0.10
SINGLE_ACTION_APPROVAL_USD=0.50
REQUIRE_APPROVAL_FOR_NEW_PAID_TOOL=false

# Output defaults
OUTPUT_FORMAT=mp4
OUTPUT_CODEC=libx264
OUTPUT_AUDIO_CODEC=aac
OUTPUT_RESOLUTION=1920x1080
OUTPUT_FPS=30
OUTPUT_CRF=23

# Optional cloud providers (none required for the zero-key path)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=