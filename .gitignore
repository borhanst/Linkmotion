# ---------------------------------------------------------------------------
# AI News Agent - .gitignore
# ---------------------------------------------------------------------------

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
# NOTE: `lib/` (dir rule) would also ignore the project's own lib package.
# Ignore contents instead, then re-include the project modules.
lib/*
!lib/*.py
lib64/
parts/
sdist/
var/
wheels/
share/
python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.coverage.*
.cache

# --- Virtual environments ---
venv/
ENV/
env/
.venv/
.env
.env.local
.env.*.local

# --- Node / frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Outputs & rendered video (large binary artifacts) ---
out/
*.mp4
*.webm
*.avi
*.mov
*.mkv
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.mp3
*.wav
*.srt

# --- Per-video project artifacts ---
# Ignore large media subdirectories; keep JSON/markdown artifacts tracked
projects/*/audio/
projects/*/assets/raw/
projects/*/renders/
projects/*/_record/
projects/*/_concat.txt

# --- Inspiration library (per-user reference bank, never pushed) ---
/inspiration/

# --- Logs ---
*.log
logs/
npm-debug.log*

# --- Misc ---
.tmp/
.tmp*/
/tmp/


projects/*