{
  "$id": "https://ai-news-agent/schemas/proposal.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal Packet",
  "description": "Stage 2 (proposal) output: concept options, selected concept, production plan, cost estimate, approval.",
  "type": "object",
  "required": ["concept_options", "selected_concept", "target_duration_sec"],
  "properties": {
    "slug": {"type": "string"},
    "pipeline": {"type": "string"},
    "format": {"type": "string", "enum": ["short", "long"]},
    "model_name": {"type": "string"},
    "lab": {"type": "string"},
    "concept_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["concept_id", "angle"],
        "properties": {
          "concept_id": {"type": "string"},
          "angle": {"type": "string"},
          "why": {"type": "string"},
          "structure": {"type": "string"},
          "audience": {"type": "string"}
        }
      }
    },
    "selected_concept": {"type": "string"},
    "target_duration_sec": {"type": "number", "exclusiveMinimum": 0},
    "production_plan": {
      "type": "object",
      "properties": {
        "beats": {"type": "integer"},
        "scenes": {"type": "integer"},
        "scene_types": {"type": "array", "items": {"type": "string"}},
        "assets": {"type": "array", "items": {"type": "string"}},
        "render_runtime": {"type": "string"}
      }
    },
    "cost_estimate": {
      "type": "object",
      "properties": {
        "total_usd": {"type": "number", "minimum": 0},
        "line_items": {"type": "array"}
      }
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["pending", "approved", "approved_with_changes"]},
        "notes": {"type": "string"}
      }
    }
  }
}